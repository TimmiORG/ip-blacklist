<!-- Script for a dropdown submenu to be active on hover or click on large displays and only click on mobile/small screens -->
<script>
  $(document).ready(function() {
    const $dropdownSubmenus = $('.dropdown-submenu')
    const $submenuLinks = $('.dropdown-submenu > a')
    const $submenus = $('.dropdown-submenu .dropdown-menu')

    function isMobile() {
      return $(window).width() < 768
    }

    function clickFunctionality(e) {
      e.preventDefault()
      e.stopPropagation()
      const $submenu = $(this).next('.dropdown-menu')
      $submenus.not($submenu).hide()
      $submenu.toggle()
    }

    function setDropdownBehavior() {
      // Clear all existing events
      $dropdownSubmenus.off('hover')
      $submenuLinks.off('click')

      if (isMobile()) {
        $submenuLinks.on('click', clickFunctionality)
      } else {
        $dropdownSubmenus.hover(
          function() {
            $(this).children('.dropdown-menu').stop(true, true).slideDown(200)
          },
          function() {
            $(this).children('.dropdown-menu').stop(true, true).slideUp(200)
          }
        )
        $submenuLinks.on('click', clickFunctionality)
      }
    }

    // Initialize and set up resize handler
    setDropdownBehavior()
    $(window).on('resize', setDropdownBehavior)
  })
</script>

