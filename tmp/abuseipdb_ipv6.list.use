<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Check if the cookie exists
    if (!getCookie('range_alert_toast_closed')) {
      toastr.options = {
        "closeButton": true,
        "newestOnTop": true,
        "progressBar": true,
        "positionClass": "toast-top-right",
        "preventDuplicates": true,
        "showDuration": "300",
        "hideDuration": "1000",
        "extendedTimeOut": "3000",
        "showMethod": "fadeIn",
        "hideMethod": "fadeOut",
        "onHidden": function() {
          // Set a cookie when the toast is closed
          setCookie('range_alert_toast_closed', 'true', 36500)
        }
      }

      toastr.info(
        "Check out our <a href='/tutorial/range-alerts' style='color: #ffdd57
        "Update", {
          timeOut: 120000, // 2 minutes
        }
      )
    }
  })
</script>
 

